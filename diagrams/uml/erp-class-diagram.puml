@startuml
title TriggerIQ ERP - Class Diagram

' --- ERP Core ---
class Product {
  +String name
  +String SKU
  +int quantity
  +float price
  +getStockLevel()
  +updateStock(int)
}

class Customer {
  +String name
  +String email
  +String phone
  +List<Order> orders
  +addOrder(Order)
}

class Order {
  +int orderNumber
  +Date orderDate
  +List<Product> products
  +float totalAmount
  +Customer customer
  +createInvoice()
  +updateStatus()
}

class Invoice {
  +int invoiceNumber
  +Date invoiceDate
  +float totalAmount
  +Order order
  +Payment payment
}

class Payment {
  +int paymentId
  +float amount
  +Date paymentDate
  +String method
  +Invoice invoice
}

' --- ERP Modules ---
class InventoryModule {
  +List<Product> products
  +checkStock(Product)
  +updateStock(Product, int)
}

class SalesModule {
  +List<Order> orders
  +createOrder(Customer, List<Product>)
  +generateInvoice(Order)
}

class FinanceModule {
  +List<Invoice> invoices
  +processPayment(Payment)
}

' --- AI/ML ---
class AIRecommender {
  +predictDemand(Product)
  +suggestReorder(Product)
}

class Chatbot {
  +answerCustomerQuery(String)
  +provideOrderStatus(Order)
}

' --- Relationships ---
Customer "1" --> "*" Order
Order "1" --> "1" Invoice
Invoice "1" --> "1" Payment
InventoryModule "1" --> "*" Product
SalesModule "1" --> "*" Order
FinanceModule "1" --> "*" Invoice

AIRecommender --> Product
Chatbot --> Customer
Chatbot --> Order

@enduml